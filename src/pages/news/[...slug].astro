---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import BackToPrev from "@components/BackToPrev.astro";
import { NEWS } from "@consts";

export async function getStaticPaths() {
  const news = (await getCollection("news"))
    .filter(item => !item.data.draft && !item.data.inline);
  return news.map(entry => ({
    params: { slug: entry.slug },
    props: entry,
  }));
}

type Props = CollectionEntry<"news">;

const entry = Astro.props;
const { Content } = await entry.render();
---

<PageLayout title={entry.data.title ?? NEWS.TITLE} description={NEWS.DESCRIPTION}>
  <Container>
    <div class="animate">
      <BackToPrev href="/news">
        Back to news
      </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate text-sm opacity-75">
        <FormattedDate date={entry.data.date} />
      </div>
      <div class="animate text-2xl font-semibold text-black dark:text-white">
        {entry.data.title}
      </div>
    </div>
    <article class="animate prose dark:prose-invert max-w-none">
      <Content />
    </article>
  </Container>
</PageLayout>
