---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import PublicationCard from "@components/PublicationCard.astro";
import { PUBLICATIONS } from "@consts";

const publications = (await getCollection("publications"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const years = [...new Set(publications.map(p => p.data.date.getFullYear()))]
  .sort((a, b) => b - a);

const byYear = years.map(year => ({
  year,
  entries: publications.filter(p => p.data.date.getFullYear() === year),
}));
---

<PageLayout title={PUBLICATIONS.TITLE} description={PUBLICATIONS.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate font-semibold text-black dark:text-white">
        Publications
      </div>
      <div class="space-y-10">
        {
          byYear.map(group => (
            <section class="animate space-y-6">
              <h2 class="text-sm opacity-75 border-b border-black/10 dark:border-white/15 pb-2">
                {group.year}
              </h2>
              <div class="space-y-8">
                {group.entries.map(entry => (
                  <PublicationCard entry={entry} />
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </Container>
</PageLayout>
